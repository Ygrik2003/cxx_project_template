{
	"name": "Arch Linux Dev Container",
	"build": {
		"dockerfile": "Dockerfile",
		"target": "${localEnv:TLT_DEVCONTAINER_TARGET}"
		// "cacheFrom": "ghcr.io/ygrik2003/cxx_project_template/devcontainer:main-${localEnv:TLT_DEVCONTAINER_TARGET}"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools"
			]
		}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	"runArgs": [
		// Hardware GL/Vulkan via the host DRM devices.
		"--device=/dev/dri",
		// X11 MIT-SHM and Mesa shared buffers need the host IPC namespace.
		"--ipc=host"
	],
	"mounts": [
		// Wayland compositor socket. XDG_RUNTIME_DIR inside the container is
		// remapped to a fixed path so nothing depends on the numeric uid.
		"source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=/tmp/xdg-runtime/${localEnv:WAYLAND_DISPLAY},type=bind",
		// X11 (Xwayland) sockets, used when SDL_VIDEODRIVER=x11.
		"source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
	],
	"containerEnv": {
		"XDG_RUNTIME_DIR": "/tmp/xdg-runtime",
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		"DISPLAY": "${localEnv:DISPLAY}",
		"XDG_SESSION_TYPE": "wayland"
		// SDL_VIDEODRIVER is deliberately unset: SDL autodetects wayland first
		// and falls back to x11. Override per-run to force a backend.
	},
	"remoteUser": "dev",
	"postCreateCommand": "sudo chown dev /tmp/xdg-runtime && sudo chmod 700 /tmp/xdg-runtime"
}