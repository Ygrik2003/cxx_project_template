{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 11,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 3,
        "patch": 3
    },
    "configurePresets": [
        {
            "name": "base",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/.build/${presetName}",
            "hidden": true
        },
        {
            "name": "clang-linux",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/toolchains/clang-linux.cmake"
        },
        {
            "name": "gcc-linux",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/toolchains/gcc-linux.cmake"
        },
        {
            "name": "android",
            "inherits": "base",
            "hidden": true,
            "$comment": "At this moment android NDK (r30) didnt suport import std;",
            "toolchainFile": "${sourceDir}/cmake/toolchains/clang-android.cmake"
        }
    ]
}